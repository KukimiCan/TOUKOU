# このファイルをコピーして .env.local を作り、値を入れる（.env.local は Git に入らない）。
#   cp .env.example .env.local
# 値はチームの共有場所から受け取る。キーを Git や issue、チャットの公開チャンネルに貼らないこと。

# --- Supabase（Project Settings > API Keys / Data API で確認できる） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 管理者権限のキー。サーバー側のコードだけで使う。NEXT_PUBLIC_ を付けないこと。
SUPABASE_SECRET_KEY=

# --- AI ---
# openai / google / mock のどれか。mock なら AI のキーが無くても動く（仮の結果を返す）。
AI_PROVIDER=mock
# 使うモデル名。画像入力に対応したモデルを AI 担当が決めて、チームに共有する。
AI_MODEL=
# AI_PROVIDER=openai のとき
OPENAI_API_KEY=
# AI_PROVIDER=google のとき
GOOGLE_GENERATIVE_AI_API_KEY=
