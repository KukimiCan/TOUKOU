# このファイルをコピーして .env.local を作り、値を入れる（.env.local は Git に入らない）。
#   cp .env.example .env.local
# 値はチームの共有場所から受け取る。キーを Git や issue、チャットの公開チャンネルに貼らないこと。

# --- Supabase（Project Settings > API Keys / Data API で確認できる） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 管理者権限のキー。サーバー側のコードだけで使う。NEXT_PUBLIC_ を付けないこと。
SUPABASE_SECRET_KEY=

# --- AI ---
# openai / google / mock のどれか。mock なら AI のキーが無くても動く（仮の結果を返す）。
AI_PROVIDER=mock
# 使うモデル名。画像入力に対応したモデルを AI 担当が決めて、チームに共有する。
AI_MODEL=
# AI のキーは、各ユーザーがアプリの「AI キー」画面（/settings）で自分のものを登録する（#220）。
# サーバーはそのキーを暗号化して DB に保存する。そのための秘密（32 文字以上のランダムな文字列）をここに入れる。
# 作り方：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 一度決めたら変えない（変えると、登録済みのキーが読めなくなり、全員が登録し直しになる）。mock なら要らない。
AI_KEY_ENCRYPTION_SECRET=
